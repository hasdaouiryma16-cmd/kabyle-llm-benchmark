data/train/raw/*
!data/train/raw/.gitkeep
# Index vectoriels RAG (regénérables)
*.lance/
lancedb/
# Poids de modèles
*.gguf
*.safetensors
*.bin
*.pt
models/
checkpoints/
outputs/

