---
import { type Lang, MODEL_INFO, REPO_URL, sizeLabel, t } from "../lib/i18n";
import { METHODS, type Method, categoryCount, families, results } from "../lib/results";
import { METHOD_STYLE, isHigh } from "../lib/view";
import PageHeader from "./PageHeader.astro";
import SectionHeading from "./SectionHeading.astro";
import Toc from "./Toc.astro";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const d = t[lang];
const r = results;
const fams = r ? families(r) : [];
const pub = r?.test_set.public_items ?? 41;
const priv = r?.test_set.private_items ?? 11;
const categories = r?.categories ?? [];
const label = (c: { label_fr: string; label_en: string }) => (lang === "fr" ? c.label_fr : c.label_en);
---

<PageHeader lang={lang} page="method" title={d.pageTitle.method} subtitle={d.methodLead} />

<div class="wrap doc">
  <Toc lang={lang} items={d.sections.method} />
  <div class="doc-main">
    <section class="doc-sec" id="jeu-de-test">
      <SectionHeading title={d.testsetTitle} />
      {d.testsetBody(pub, priv).map((p) => <p class="lead">{p}</p>)}
      <table class="plain">
        <thead>
          <tr><th>{lang === "fr" ? "Catégorie" : "Category"}</th><th>{lang === "fr" ? "Ce qui est demandé" : "Task"}</th><th class="num">Tests</th></tr>
        </thead>
        <tbody>
          {categories.map((c) => (
            <tr>
              <td><strong>{label(c)}</strong></td>
              <td>{d.categoryDescriptions[c.id]}</td>
              <td class="num mono">{r ? categoryCount(r, c.id) : ""}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </section>

    <section class="doc-sec" id="protocole">
      <SectionHeading title={d.protocolTitle} />
      <ol class="steps">
        {d.protocol.map((p) => (
          <li><h3>{p.h}</h3><p>{p.p}</p></li>
        ))}
      </ol>
      <h3 class="sub-title">{d.scaleTitle}</h3>
      <div class="scale">
        {d.scoreScale.map((s, i) => {
          const v = (i / 3) * 100;
          return (
            <div class={isHigh(v) ? "hi" : ""} style={`--v:${v}`}>
              <b>{i}</b>
              {s}
            </div>
          );
        })}
      </div>
    </section>

    <section class="doc-sec" id="aides">
      <SectionHeading title={d.methodsTitle} />
      <div class="method-list">
        {d.methods.map((m) => (
          <div class="method-card" style={`--c:${METHOD_STYLE[m.id as Method].color}`}>
            <h3><i class={`mk ${METHOD_STYLE[m.id as Method].shape}`} style={`--c:${METHOD_STYLE[m.id as Method].color}`}></i>{m.h}</h3>
            <p>{m.p}</p>
          </div>
        ))}
      </div>
    </section>

    <section class="doc-sec" id="modeles">
      <SectionHeading title={d.modelsTitle} />
      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th>{d.modelsCols.model}</th>
              <th>{d.modelsCols.maker}</th>
              <th>{d.modelsCols.access}</th>
              <th>{d.modelsCols.size}</th>
              <th>{d.modelsCols.methods}</th>
            </tr>
          </thead>
          <tbody>
            {fams.map((f) => {
              const info = MODEL_INFO[f.key];
              return (
                <tr>
                  <td><strong>{f.label}</strong></td>
                  <td>{info?.maker ?? f.provider}</td>
                  <td>{f.local ? d.access.local : d.access.api}</td>
                  <td>{sizeLabel(info?.params ?? null, lang)}</td>
                  <td>
                    <span class="tags">
                      {METHODS.filter((m) => f.byMethod[m]).map((m) => (
                        <span class="method-tag" style={`--c:${METHOD_STYLE[m].color}`}>{d.method[m]}</span>
                      ))}
                    </span>
                  </td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>
    </section>

    <section class="doc-sec" id="glossaire">
      <SectionHeading title={d.glossaryTitle} />
      <dl class="glossary">
        {d.glossary.map((g) => (
          <div><dt>{g.t}</dt><dd>{g.d}</dd></div>
        ))}
      </dl>
    </section>

    <section class="doc-sec" id="limites">
      <SectionHeading title={d.limitsTitle} />
      <ul class="limits">
        {d.limits.map((l) => <li>{l}</li>)}
      </ul>
      <div class="open-box">
        <div>
          <h3>{d.reproduceTitle}</h3>
          <p>{d.reproduceBody}</p>
        </div>
        <a class="btn btn-primary" href={REPO_URL}>{d.repo} →</a>
      </div>
    </section>
  </div>
</div>
