---
import { type Lang, href, t } from "../lib/i18n";
import { type Method, families, ranked, results, totalGraded } from "../lib/results";
import { METHOD_STYLE, fmt, joinList, pct } from "../lib/view";
import Frieze from "./Frieze.astro";
import SectionHeading from "./SectionHeading.astro";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const d = t[lang];
const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");

const r = results;
const order = r ? ranked(r) : [];
const fams = r ? families(r) : [];
const gains = r?.gains.filter((g) => g.overall.gain_points !== undefined) ?? [];
const familyOf = (key: string) => fams.find((f) => f.key === key);

const best = order[0];
const ftGain = [...gains].filter((g) => g.variant_type === "finetuned").sort((a, b) => (b.overall.gain_points ?? 0) - (a.overall.gain_points ?? 0))[0];
const largeFewshot = gains.filter((g) => g.variant_type === "fewshot" && !familyOf(g.base)?.local);
const fsMin = Math.min(...largeFewshot.map((g) => g.overall.gain_points ?? 0));
const fsMax = Math.max(...largeFewshot.map((g) => g.overall.gain_points ?? 0));
const small = fams.filter((f) => f.local);
const ftAfter = ftGain?.overall.after_pct ?? 0;
const beaten = fams.filter((f) => !f.local && (f.byMethod.base?.overall.human_pct ?? 100) < ftAfter).map((f) => f.label);

const findings =
  r && best && ftGain
    ? d.findings({
        bestLabel: best.label,
        bestPct: fmt(best.overall.human_pct, lang),
        fewshotLarge:
          Math.round(fsMin) === Math.round(fsMax)
            ? `${Math.round(fsMax)}`
            : `${Math.round(fsMin)} ${lang === "fr" ? "à" : "to"} ${Math.round(fsMax)}`,
        fewshotLargeLabels: joinList(largeFewshot.map((g) => familyOf(g.base)?.label ?? g.base), lang),
        smallLabels: joinList(small.map((f) => f.label), lang),
        smallBase: joinList(small.map((f) => pct(f.byMethod.base?.overall.human_pct, lang)), lang),
        ftLabel: familyOf(ftGain.base)?.label ?? ftGain.base,
        ftBefore: fmt(ftGain.overall.before_pct, lang),
        ftAfter: fmt(ftGain.overall.after_pct, lang),
        ftBeats: joinList(beaten, lang),
      })
    : [];
const podium = order.slice(0, 3);
const kpis = r
  ? [
      { v: pct(best?.overall.human_pct, lang), l: d.kpi.best, s: best?.label },
      { v: `+${fmt(ftGain?.overall.gain_points, lang)} ${d.points}`, l: d.kpi.gain, s: familyOf(ftGain?.base ?? "")?.label },
      { v: totalGraded(r).toLocaleString(d.locale), l: d.kpi.graded, s: `${order.length} configurations` },
      { v: String(r.test_set.public_items ?? r.items?.length ?? ""), l: d.kpi.tests, s: lang === "fr" ? "écrits par l'autrice, locutrice native" : "written by the author, a native speaker" },
    ]
  : [];
---

<section class="hero">
  <div class="lattice" aria-hidden="true"></div>
  <div class="hero-in">
    <p class="hero-tif anim" aria-hidden="true">ⵜⴰⵇⴱⴰⵢⵍⵉⵜ</p>
    <p class="hero-greet anim" style="animation-delay:80ms">{d.greeting}</p>
    <h1 class="anim" style="animation-delay:140ms">{d.heroTitle}</h1>
    <div class="hero-rule anim" style="animation-delay:220ms" aria-hidden="true"><span></span><i>◆</i><span></span></div>
    <p class="hero-lead anim" style="animation-delay:300ms">{d.heroLead}</p>
    <div class="hero-cta anim" style="animation-delay:380ms">
      <a class="btn btn-saffron" href={href(base, "results", lang)}>{d.heroCta}</a>
      <a class="btn btn-ghost-light" href={href(base, "answers", lang)}>{d.heroCta2}</a>
    </div>
  </div>
  <Frieze variant="diamond" class="hero-frieze" />
</section>

{!r ? (
  <div class="wrap section"><div class="pending"><strong>{d.pending}</strong>{d.pendingBody}</div></div>
) : (
  <>
    <section class="section">
      <div class="wrap">
        <div class="reveal"><SectionHeading eyebrow="Benchmark" title={d.eyebrows.kpi} /></div>
        <div class="grid-4">
          {kpis.map((k, i) => (
            <div class="card card-lift kpi reveal" style={`transition-delay:${i * 90}ms`}>
              <strong>{k.v}</strong>
              <span>{k.l}</span>
              <small>{k.s}</small>
            </div>
          ))}
        </div>
      </div>
    </section>

    <div class="divider" aria-hidden="true"><span></span><svg width="34" height="14" viewBox="0 0 34 14" fill="none"><path d="M17 1 L23 7 L17 13 L11 7 Z" stroke="currentColor" stroke-width="1.3" /><path d="M17 4.5 L19.5 7 L17 9.5 L14.5 7 Z" fill="currentColor" /><path d="M0 7 L9 7 M25 7 L34 7" stroke="currentColor" stroke-width="1.3" /></svg><span></span></div>

    <section class="section">
      <div class="wrap narrow">
        <div class="reveal"><SectionHeading eyebrow={d.eyebrows.findings} title={d.findingsTitle} /></div>
        <ol class="findings">
          {findings.map((f, i) => (
            <li class="reveal" style={`transition-delay:${i * 60}ms`}><div><h3>{f.h}</h3><p>{f.p}</p></div></li>
          ))}
        </ol>
      </div>
    </section>

    <section class="section band-cream">
      <div class="weave" aria-hidden="true"></div>
      <div class="wrap rel">
        <div class="reveal"><SectionHeading eyebrow={d.eyebrows.podium} title={d.homeTopTitle} /></div>
        <div class="podium">
          {podium.map((m, i) => {
            const style = METHOD_STYLE[(m.variant as Method) ?? "base"];
            return (
              <div class:list={["card card-lift podium-card reveal", i === 0 && "first"]} style={`transition-delay:${i * 90}ms`}>
                <span class="rank-badge"><span>{i + 1}</span></span>
                <h3>{familyOf(m.base ?? m.key)?.label ?? m.label}</h3>
                <span class="method-tag" style={`--c:${style.color}`}>{d.method[m.variant] ?? m.variant}</span>
                <div class="score">{pct(m.overall.human_pct, lang)}</div>
                {m.overall.human_pct_ci95 && (
                  <p class="meta">
                    {lang === "fr" ? "fourchette" : "range"} {fmt(m.overall.human_pct_ci95[0], lang, 0)}–{pct(m.overall.human_pct_ci95[1], lang, 0)}
                  </p>
                )}
              </div>
            );
          })}
        </div>
        <p class="center reveal" style="margin-top:44px"><a class="btn btn-outline" href={href(base, "results", lang)}>{d.homeTopMore}</a></p>
      </div>
    </section>
  </>
)}

<section class="story">
  <div class="lattice" aria-hidden="true"></div>
  <Frieze variant="diamond" class="story-frieze top" />
  <div class="wrap story-grid reveal">
    <div>
      <SectionHeading eyebrow={d.eyebrows.why} title={d.whyTitle} align="left" dark />
      {d.whyBody.map((p) => <p class="story-p">{p}</p>)}
      <a class="u-link story-link" href={href(base, "method", lang)}>{d.nav.method} <span aria-hidden="true">→</span></a>
    </div>
    <div class="story-facts">
      {d.facts.map((f) => (
        <div class="fact">
          <strong>{f.value}</strong>
          <span>{f.label}</span>
        </div>
      ))}
    </div>
  </div>
</section>
