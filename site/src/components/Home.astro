---
import { REPO_URL, type Lang, href, t } from "../lib/i18n";
import { type Method, families, ranked, results, totalGraded } from "../lib/results";
import { METHOD_STYLE, fmt, joinList, pct } from "../lib/view";
import Frieze from "./Frieze.astro";
import SectionHeading from "./SectionHeading.astro";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const d = t[lang];
const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");

const r = results;
const order = r ? ranked(r) : [];
const fams = r ? families(r) : [];
const gains = r?.gains.filter((g) => g.overall.gain_points !== undefined) ?? [];
const familyOf = (key: string) => fams.find((f) => f.key === key);

const best = order[0];
const ftGain = [...gains].filter((g) => g.variant_type === "finetuned").sort((a, b) => (b.overall.gain_points ?? 0) - (a.overall.gain_points ?? 0))[0];
const largeFewshot = gains.filter((g) => g.variant_type === "fewshot" && !familyOf(g.base)?.local);
const fsMin = Math.min(...largeFewshot.map((g) => g.overall.gain_points ?? 0));
const fsMax = Math.max(...largeFewshot.map((g) => g.overall.gain_points ?? 0));
const small = fams.filter((f) => f.local);
const ftAfter = ftGain?.overall.after_pct ?? 0;
const beaten = fams.filter((f) => !f.local && (f.byMethod.base?.overall.human_pct ?? 100) < ftAfter).map((f) => f.label);

const findings =
  r && best && ftGain
    ? d.findings({
        bestLabel: best.label,
        bestPct: fmt(best.overall.human_pct, lang),
        fewshotLarge:
          Math.round(fsMin) === Math.round(fsMax)
            ? `${Math.round(fsMax)}`
            : `${Math.round(fsMin)} ${lang === "fr" ? "à" : "to"} ${Math.round(fsMax)}`,
        fewshotLargeLabels: joinList(largeFewshot.map((g) => familyOf(g.base)?.label ?? g.base), lang),
        smallLabels: joinList(small.map((f) => f.label), lang),
        smallBase: joinList(small.map((f) => pct(f.byMethod.base?.overall.human_pct, lang)), lang),
        ftLabel: familyOf(ftGain.base)?.label ?? ftGain.base,
        ftBefore: fmt(ftGain.overall.before_pct, lang),
        ftAfter: fmt(ftGain.overall.after_pct, lang),
        ftBeats: joinList(beaten, lang),
      })
    : [];
const top = order.slice(0, 6);
const date = r ? new Date(r.generated_at).toLocaleDateString(d.locale, { dateStyle: "long" }) : "";
const stats = r
  ? [
      { v: pct(best?.overall.human_pct, lang), l: d.kpi.best, s: best?.label },
      { v: `+${fmt(ftGain?.overall.gain_points, lang)} ${d.points}`, l: d.kpi.gain, s: familyOf(ftGain?.base ?? "")?.label },
      { v: totalGraded(r).toLocaleString(d.locale), l: d.kpi.graded, s: `${order.length} configurations` },
      { v: String(r.test_set.public_items ?? r.items?.length ?? ""), l: d.kpi.tests, s: lang === "fr" ? "écrits par l'autrice, locutrice native" : "written by the author, a native speaker" },
    ]
  : [];
---

<section class="hero">
  <div class="lattice" aria-hidden="true"></div>
  <div class="wrap hero-grid">
    <div class="hero-text">
      <p class="hero-greet"><span class="kab">ⵣ</span> {d.greeting} <span class="tif" aria-hidden="true">ⵜⴰⵇⴱⴰⵢⵍⵉⵜ</span></p>
      <h1>{d.heroTitle}</h1>
      <p class="hero-lead">{d.heroLead}</p>
      <div class="hero-cta">
        <a class="btn btn-saffron" href={href(base, "results", lang)}>{d.heroCta} →</a>
        <a class="btn btn-ghost-light" href={href(base, "answers", lang)}>{d.heroCta2}</a>
      </div>
      {r && <p class="hero-meta">{lang === "fr" ? "Jeu de test" : "Test set"} {r.test_set.version} · {date}</p>}
    </div>

    {r && (
      <div class="mini-board">
        <div class="mini-head">
          <span>{d.rankingTitle}</span>
          <span class="mini-sub">{d.colScore}</span>
        </div>
        <ol>
          {top.map((m, i) => {
            const method = (m.variant as Method) ?? "base";
            const v = m.overall.human_pct ?? 0;
            return (
              <li>
                <span class="mini-rank">{i + 1}</span>
                <span class="mini-model">
                  <strong>{familyOf(m.base ?? m.key)?.label ?? m.label}</strong>
                  <span class="method-tag" style={`--c:${METHOD_STYLE[method].color}`}>{d.method[method]}</span>
                </span>
                <span class="mini-bar"><i style={`width:${v}%;--c:${METHOD_STYLE[method].color}`}></i></span>
                <span class="mini-score">{pct(v, lang)}</span>
              </li>
            );
          })}
        </ol>
        <a class="mini-more" href={href(base, "results", lang)}>{d.homeTopMore} ({order.length}) →</a>
      </div>
    )}
  </div>
  <Frieze variant="diamond" height={10} class="hero-frieze" />
</section>

{!r ? (
  <div class="wrap section"><div class="pending"><strong>{d.pending}</strong>{d.pendingBody}</div></div>
) : (
  <>
    <section class="stats-band" aria-label={d.eyebrows.kpi}>
      <div class="wrap stats">
        {stats.map((k) => (
          <div class="stat">
            <strong>{k.v}</strong>
            <span>{k.l}</span>
            <small>{k.s}</small>
          </div>
        ))}
      </div>
    </section>

    <section class="section">
      <div class="wrap">
        <SectionHeading eyebrow={d.eyebrows.findings} title={d.findingsTitle} />
        <ol class="findings">
          {findings.map((f) => (
            <li><h3>{f.h}</h3><p>{f.p}</p></li>
          ))}
        </ol>
      </div>
    </section>
  </>
)}

<section class="section alt">
  <div class="wrap two-col">
    <div>
      <SectionHeading eyebrow={d.eyebrows.why} title={d.whyTitle} />
      {d.whyBody.map((p) => <p class="lead">{p}</p>)}
    </div>
    <aside class="side-facts">
      {d.facts.map((f) => (
        <div class="fact">
          <strong>{f.value}</strong>
          <span>{f.label}</span>
        </div>
      ))}
    </aside>
  </div>
</section>

<section class="section">
  <div class="wrap">
    <SectionHeading eyebrow={lang === "fr" ? "Données ouvertes" : "Open data"} title={d.reproduceTitle} subtitle={d.reproduceBody} />
    <div class="link-cards">
      <a class="link-card" href={href(base, "method", lang)}>
        <strong>{d.nav.method}</strong>
        <span>{d.methodLead}</span>
      </a>
      <a class="link-card" href={href(base, "answers", lang)}>
        <strong>{d.nav.answers}</strong>
        <span>{lang === "fr" ? "Les 615 réponses des modèles, test par test, avec leur note." : "All 615 model answers, test by test, with their grade."}</span>
      </a>
      <a class="link-card" href={REPO_URL}>
        <strong>GitHub</strong>
        <span>{lang === "fr" ? "Code, jeu de test public, notebooks et résultats bruts." : "Code, public test set, notebooks and raw results."}</span>
      </a>
    </div>
  </div>
</section>
