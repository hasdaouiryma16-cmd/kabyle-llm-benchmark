---
// Motif géométrique inspiré des poteries et bijoux kabyles : losanges emboîtés,
// dents de scie et yaz (ⵣ) au centre. Couleurs : corail, jaune, émail vert et bleu.
const tri = (x: number, y: number, up: boolean, s = 14) =>
  up ? `M${x} ${y + s} L${x + s / 2} ${y} L${x + s} ${y + s}Z` : `M${x} ${y} L${x + s / 2} ${y + s} L${x + s} ${y}Z`;
const colors = ["var(--accent)", "var(--gold)", "var(--green)", "var(--blue)"];
const teeth = Array.from({ length: 12 }, (_, i) => i);
---

<svg class="motif" viewBox="0 0 400 460" aria-hidden="true" focusable="false">
  <!-- dents de scie, en haut et en bas -->
  {teeth.map((i) => <path d={tri(116 + i * 14, 0, true)} fill={colors[i % 4]} />)}
  {teeth.map((i) => <path d={tri(116 + i * 14, 446, false)} fill={colors[(i + 2) % 4]} />)}
  <!-- grand losange et bordure en zigzag -->
  <path d="M200 26 L388 230 L200 434 L12 230Z" fill="none" stroke="var(--ink-2)" stroke-width="2" opacity="0.55" />
  <path d="M200 44 L370 230 L200 416 L30 230Z" fill="none" stroke="var(--gold)" stroke-width="3" stroke-dasharray="10 7" />
  <!-- losange corail -->
  <path d="M200 80 L337 230 L200 380 L63 230Z" fill="var(--accent)" />
  <path d="M200 112 L308 230 L200 348 L92 230Z" fill="none" stroke="var(--surface)" stroke-width="3" />
  <path d="M200 136 L286 230 L200 324 L114 230Z" fill="var(--surface)" />
  <!-- petits losanges aux quatre points -->
  <path d="M106 120 l14 15 -14 15 -14 -15Z" fill="var(--green)" />
  <path d="M294 120 l14 15 -14 15 -14 -15Z" fill="var(--blue)" />
  <path d="M106 310 l14 15 -14 15 -14 -15Z" fill="var(--blue)" />
  <path d="M294 310 l14 15 -14 15 -14 -15Z" fill="var(--green)" />
  <path d="M200 52 l10 11 -10 11 -10 -11Z" fill="var(--accent)" />
  <path d="M200 386 l10 11 -10 11 -10 -11Z" fill="var(--accent)" />
  <!-- yaz -->
  <text x="200" y="232" text-anchor="middle" dominant-baseline="central" font-size="104" fill="var(--accent)" style="font-family: var(--font-kab)">ⵣ</text>
</svg>
