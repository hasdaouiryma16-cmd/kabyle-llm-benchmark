---
interface Props {
  eyebrow?: string;
  title: string;
  subtitle?: string;
  dark?: boolean;
}
const { eyebrow, title, subtitle, dark = false } = Astro.props;
---

<div class:list={["sh", dark && "sh-dark"]}>
  {eyebrow && <p class="sh-eyebrow">{eyebrow}</p>}
  <h2>{title}</h2>
  {subtitle && <p class="sh-sub">{subtitle}</p>}
</div>
