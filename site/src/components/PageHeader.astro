---
// En-tête compact des pages secondaires : fil d'Ariane, titre, description.
import { type Lang, type PageId, href, t } from "../lib/i18n";
import Frieze from "./Frieze.astro";

interface Props {
  lang: Lang;
  page: PageId;
  title: string;
  subtitle?: string;
}
const { lang, page, title, subtitle } = Astro.props;
const d = t[lang];
const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
---

<header class="page-banner">
  <div class="wrap page-banner-in">
    <nav class="crumbs" aria-label={lang === "fr" ? "Fil d'Ariane" : "Breadcrumb"}>
      <a href={href(base, "home", lang)}>{d.nav.home}</a>
      <span class="dia" aria-hidden="true">◆</span>
      <span aria-current="page">{d.nav[page]}</span>
    </nav>
    <h1>{title}</h1>
    {subtitle && <p class="page-banner-sub">{subtitle}</p>}
  </div>
  <Frieze variant="diamond" height={10} class="banner-frieze" />
</header>
