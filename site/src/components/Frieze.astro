---
// Frise répétable, comme la bordure d'un tapis kabyle (même répertoire que Tamazɣa).
//   carpet  : triangles opposés entre deux filets
//   diamond : losanges à œil plein reliés par un filet
//   chevron : l'eau qui descend de la montagne
interface Props {
  variant?: "carpet" | "diamond" | "chevron";
  height?: number;
  class?: string;
}
const { variant = "diamond", height = 14, class: cls = "" } = Astro.props;
const id = `fz-${variant}-${Math.random().toString(36).slice(2, 8)}`;
const w = 30;
---

<svg aria-hidden="true" class={`frieze-svg ${cls}`} width="100%" height={height} viewBox={`0 0 ${w} 20`} preserveAspectRatio="none">
  <defs>
    <pattern id={id} width={w} height="20" patternUnits="userSpaceOnUse">
      {variant === "carpet" && (
        <>
          <path d="M0 3 L30 3 M0 17 L30 17" stroke="currentColor" stroke-width="1.2" />
          <path d="M2 14 L7.5 6 L13 14 Z M17 6 L22.5 14 L28 6 Z" fill="currentColor" />
        </>
      )}
      {variant === "diamond" && (
        <>
          <path d="M10 3 L17 10 L10 17 L3 10 Z" fill="none" stroke="currentColor" stroke-width="1.5" />
          <path d="M10 7.3 L12.7 10 L10 12.7 L7.3 10 Z M20 10 L30 10" fill="currentColor" stroke="currentColor" stroke-width="1.5" />
        </>
      )}
      {variant === "chevron" && (
        <path d="M0 16 L7.5 4 L15 16 L22.5 4 L30 16" fill="none" stroke="currentColor" stroke-width="2" />
      )}
    </pattern>
  </defs>
  <rect width="100%" height="20" fill={`url(#${id})`} />
</svg>
