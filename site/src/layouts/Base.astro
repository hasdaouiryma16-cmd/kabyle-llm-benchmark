---
import Frieze from "../components/Frieze.astro";
import { type Lang, type PageId, PROFILE_URL, REPO_URL, ROUTES, href, t } from "../lib/i18n";
import "../styles/global.css";

interface Props {
  lang: Lang;
  page: PageId;
}
const { lang, page } = Astro.props;
const d = t[lang];
const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
const other: Lang = lang === "fr" ? "en" : "fr";
const canonical = new URL(href(base, page, lang), Astro.site);
const ogImage = new URL(`${base}og.png`, Astro.site);
const title = page === "home" ? `${d.pageTitle.home} · ${d.siteName}` : `${d.pageTitle[page]} · ${d.siteName}`;
const pages = Object.keys(ROUTES) as PageId[];
const dataUrl = `${REPO_URL}/blob/main/data/results/public/results.json`;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={d.description} />
    <meta name="theme-color" content="#0e2348" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="fr" href={new URL(href(base, page, "fr"), Astro.site)} />
    <link rel="alternate" hreflang="en" href={new URL(href(base, page, "en"), Astro.site)} />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={d.siteName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={d.description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={lang === "fr" ? "fr_FR" : "en_US"} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={d.description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@600;700&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@500&family=Noto+Sans+Tifinagh&display=swap"
    />
    <script is:inline>
      try {
        const saved = localStorage.getItem("theme");
        const dark = saved ? saved === "dark" : matchMedia("(prefers-color-scheme: dark)").matches;
        document.documentElement.dataset.theme = dark ? "dark" : "light";
      } catch {
        document.documentElement.dataset.theme = "light";
      }
    </script>
  </head>
  <body>
    <a class="skip" href="#main">{lang === "fr" ? "Aller au contenu" : "Skip to content"}</a>

    <header class="site-head">
      <div class="wrap nav-row">
        <a class="logo" href={href(base, "home", lang)}>
          <span class="logo-mark" aria-hidden="true">ⵣ</span>
          <span class="logo-text">
            <span class="logo-name">Kabyle LLM Benchmark</span>
            <span class="logo-tif" aria-hidden="true">ⵜⴰⵇⴱⴰⵢⵍⵉⵜ</span>
          </span>
        </a>
        <nav class="tabs" aria-label={d.menu} data-nav>
          {pages.map((p) => (
            <a href={href(base, p, lang)} aria-current={p === page ? "page" : undefined}>{d.nav[p]}</a>
          ))}
        </nav>
        <div class="nav-tools">
          <a class="lang" href={href(base, page, other)} hreflang={other} lang={other} title={d.switchLang}>{other.toUpperCase()}</a>
          <button class="theme-btn" type="button" data-theme-toggle aria-label={d.theme} title={d.theme}>
            <svg class="moon" width="16" height="16" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 3a9 9 0 1 0 9 9c0-.46-.04-.92-.1-1.36a5.39 5.39 0 0 1-4.4 2.26 5.4 5.4 0 0 1-3.14-9.8A9 9 0 0 0 12 3Z" /></svg>
            <svg class="sun" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4.5" /><path d="M12 1.5v2.5M12 20v2.5M1.5 12H4M20 12h2.5M4.6 4.6l1.8 1.8M17.6 17.6l1.8 1.8M4.6 19.4l1.8-1.8M17.6 6.4l1.8-1.8" /></svg>
          </button>
          <a class="icon-btn" href={REPO_URL} aria-label="GitHub" title="GitHub">
            <svg width="19" height="19" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 .5a11.5 11.5 0 0 0-3.64 22.41c.58.1.79-.25.79-.56v-2c-3.2.7-3.88-1.37-3.88-1.37-.53-1.33-1.28-1.69-1.28-1.69-1.05-.71.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.29 1.19-3.1-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.77 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.84 1.19 3.1 0 4.42-2.7 5.39-5.26 5.68.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .5Z" /></svg>
          </a>
        </div>
      </div>
      <Frieze variant="carpet" height={8} class="head-frieze" />
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-foot">
      <Frieze variant="diamond" height={10} class="foot-frieze" />
      <div class="wrap foot-grid">
        <div>
          <p class="foot-name"><span class="logo-mark sm" aria-hidden="true">ⵣ</span> Kabyle LLM Benchmark</p>
          <p class="foot-about">{d.footAbout}</p>
        </div>
        <nav aria-label={d.footSite}>
          <h4>{d.footSite}</h4>
          {pages.map((p) => <a href={href(base, p, lang)}>{d.nav[p]}</a>)}
        </nav>
        <div>
          <h4>{d.footProject}</h4>
          <a href={REPO_URL}>{d.footCode}</a>
          <a href={dataUrl}>{d.footData}</a>
          <a href={PROFILE_URL}>{d.footAuthor}</a>
        </div>
      </div>
      <div class="wrap foot-bottom">
        <p>{d.license}</p>
        <p><span class="kab tif-gold" aria-hidden="true">ⵜⴰⵏⵎⵉⵔⵜ</span> {d.thanks} {d.thanksBody}</p>
      </div>
    </footer>
    <script is:inline>
      document.querySelector("[data-theme-toggle]")?.addEventListener("click", () => {
        const next = document.documentElement.dataset.theme === "dark" ? "light" : "dark";
        document.documentElement.dataset.theme = next;
        try {
          localStorage.setItem("theme", next);
        } catch {}
      });
    </script>
  </body>
</html>
