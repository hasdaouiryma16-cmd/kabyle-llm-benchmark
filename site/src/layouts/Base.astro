---
import { type Lang, type PageId, PROFILE_URL, REPO_URL, ROUTES, href, t } from "../lib/i18n";
import "../styles/global.css";

interface Props {
  lang: Lang;
  page: PageId;
}
const { lang, page } = Astro.props;
const d = t[lang];
const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
const other: Lang = lang === "fr" ? "en" : "fr";
const canonical = new URL(href(base, page, lang), Astro.site);
const ogImage = new URL(`${base}og.png`, Astro.site);
const title = page === "home" ? `${d.pageTitle.home} · ${d.siteName}` : `${d.pageTitle[page]} · ${d.siteName}`;
const pages = Object.keys(ROUTES) as PageId[];
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={d.description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="fr" href={new URL(href(base, page, "fr"), Astro.site)} />
    <link rel="alternate" hreflang="en" href={new URL(href(base, page, "en"), Astro.site)} />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={d.siteName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={d.description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={lang === "fr" ? "fr_FR" : "en_US"} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={d.description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Fraunces:opsz,wght@9..144,600;9..144,700&family=Noto+Sans+Tifinagh&display=swap"
    />
    <script is:inline>
      try {
        const saved = localStorage.getItem("theme");
        const dark = saved ? saved === "dark" : matchMedia("(prefers-color-scheme: dark)").matches;
        document.documentElement.dataset.theme = dark ? "dark" : "light";
      } catch {
        document.documentElement.dataset.theme = "light";
      }
    </script>
  </head>
  <body>
    <a class="skip" href="#main">{lang === "fr" ? "Aller au contenu" : "Skip to content"}</a>
    <header class="top">
      <div class="wrap top-row">
        <a class="brand" href={href(base, "home", lang)}>
          <span class="brand-mark" aria-hidden="true">ⵣ</span>
          <span class="brand-text">Kabyle <b>LLM</b> Benchmark</span>
        </a>
        <nav class="tabs" aria-label={d.menu} data-nav>
          {pages.map((p) => (
            <a href={href(base, p, lang)} aria-current={p === page ? "page" : undefined}>{d.nav[p]}</a>
          ))}
        </nav>
        <div class="tools">
          <a class="btn-ghost" href={href(base, page, other)} hreflang={other} lang={other}>{d.switchLang}</a>
          <button class="btn-ghost icon" type="button" data-theme-toggle aria-label={d.theme} title={d.theme}>
            <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path fill="currentColor" d="M12 3a9 9 0 1 0 9 9c0-.46-.04-.92-.1-1.36a5.39 5.39 0 0 1-4.4 2.26 5.4 5.4 0 0 1-3.14-9.8A9 9 0 0 0 12 3Z" /></svg>
          </button>
          <button class="btn-ghost icon menu-btn" type="button" data-menu aria-expanded="false" aria-label={d.menu}>
            <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="currentColor" d="M3 6h18v2H3zm0 5h18v2H3zm0 5h18v2H3z" /></svg>
          </button>
        </div>
      </div>
      <div class="frieze" aria-hidden="true"></div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="foot">
      <div class="frieze" aria-hidden="true"></div>
      <div class="wrap foot-row">
        <div>
          <p class="foot-thanks"><span class="kab">{d.thanks}</span> {d.thanksBody}</p>
          <p>{d.footer} <a href={PROFILE_URL}>@hasdaouiryma16-cmd</a> · <a href={REPO_URL}>GitHub</a></p>
        </div>
        <nav class="foot-nav" aria-label={d.menu}>
          {pages.map((p) => <a href={href(base, p, lang)}>{d.nav[p]}</a>)}
        </nav>
        <p class="foot-license">{d.license}</p>
      </div>
    </footer>

    <script is:inline>
      document.querySelector("[data-theme-toggle]")?.addEventListener("click", () => {
        const next = document.documentElement.dataset.theme === "dark" ? "light" : "dark";
        document.documentElement.dataset.theme = next;
        try {
          localStorage.setItem("theme", next);
        } catch {}
      });
      const menu = document.querySelector("[data-menu]");
      const nav = document.querySelector("[data-nav]");
      menu?.addEventListener("click", () => {
        const open = nav?.classList.toggle("open");
        menu.setAttribute("aria-expanded", open ? "true" : "false");
      });
    </script>
  </body>
</html>
