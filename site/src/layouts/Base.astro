---
import Frieze from "../components/Frieze.astro";
import { type Lang, type PageId, PROFILE_URL, REPO_URL, ROUTES, href, t } from "../lib/i18n";
import "../styles/global.css";

interface Props {
  lang: Lang;
  page: PageId;
}
const { lang, page } = Astro.props;
const d = t[lang];
const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
const other: Lang = lang === "fr" ? "en" : "fr";
const canonical = new URL(href(base, page, lang), Astro.site);
const ogImage = new URL(`${base}og.png`, Astro.site);
const title = page === "home" ? `${d.pageTitle.home} · ${d.siteName}` : `${d.pageTitle[page]} · ${d.siteName}`;
const pages = Object.keys(ROUTES) as PageId[];
const dataUrl = `${REPO_URL}/blob/main/data/results/public/results.json`;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={d.description} />
    <meta name="theme-color" content="#081833" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="fr" href={new URL(href(base, page, "fr"), Astro.site)} />
    <link rel="alternate" hreflang="en" href={new URL(href(base, page, "en"), Astro.site)} />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={d.siteName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={d.description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={lang === "fr" ? "fr_FR" : "en_US"} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={d.description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@500;600;700&family=Inter:wght@300;400;500;600;700&family=Noto+Sans+Tifinagh&display=swap"
    />
    <script is:inline>document.documentElement.classList.add("js");</script>
  </head>
  <body>
    <a class="skip" href="#main">{lang === "fr" ? "Aller au contenu" : "Skip to content"}</a>

    <header class="site-head" data-head>
      <div class="announce">
        <p class="wrap">
          {d.announce.map((a, i) => (
            <>
              {i > 0 && <span class:list={["dia", i > 1 && "hide-sm"]} aria-hidden="true">◆</span>}
              <span class:list={[i > 1 && "hide-sm"]}>{a}</span>
            </>
          ))}
        </p>
      </div>
      <div class="navbar">
        <div class="wrap nav-row">
          <a class="logo" href={href(base, "home", lang)}>
            <span class="logo-name">Kabyle <em>LLM</em> Benchmark</span>
            <span class="logo-tif" aria-hidden="true">ⵜⴰⵇⴱⴰⵢⵍⵉⵜ</span>
          </a>
          <nav class="nav-links" aria-label={d.menu}>
            {pages.map((p) => (
              <a class="u-link" href={href(base, p, lang)} aria-current={p === page ? "page" : undefined}>{d.nav[p]}</a>
            ))}
          </nav>
          <div class="nav-tools">
            <a class="lang" href={href(base, page, other)} hreflang={other} lang={other} title={d.switchLang}>
              {other.toUpperCase()}
            </a>
            <a class="icon-btn hide-sm" href={REPO_URL} aria-label="GitHub" title="GitHub">
              <svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 .5a11.5 11.5 0 0 0-3.64 22.41c.58.1.79-.25.79-.56v-2c-3.2.7-3.88-1.37-3.88-1.37-.53-1.33-1.28-1.69-1.28-1.69-1.05-.71.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.29 1.19-3.1-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.77 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.84 1.19 3.1 0 4.42-2.7 5.39-5.26 5.68.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .5Z" /></svg>
            </a>
            <button class="icon-btn menu-btn" type="button" data-menu aria-expanded="false" aria-controls="mobile-menu" aria-label={d.menu}>
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
                <path class="i-open" d="M3 6h18M3 12h18M3 18h18" />
                <path class="i-close" d="M18 6 6 18M6 6l12 12" />
              </svg>
            </button>
          </div>
        </div>
        <Frieze variant="carpet" height={10} class="head-frieze" />
      </div>
      <nav class="mobile-menu" id="mobile-menu" aria-label={d.menu} hidden>
        <p class="m-eyebrow">{d.menu}</p>
        {pages.map((p) => (
          <a href={href(base, p, lang)} aria-current={p === page ? "page" : undefined}>
            {d.nav[p]} <span aria-hidden="true">→</span>
          </a>
        ))}
        <a href={href(base, page, other)} hreflang={other} lang={other}>{d.switchLang} <span aria-hidden="true">→</span></a>
        <a href={REPO_URL}>GitHub <span aria-hidden="true">→</span></a>
      </nav>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-foot">
      <Frieze variant="diamond" class="foot-frieze" />
      <div class="wrap foot-grid">
        <div class="foot-brand">
          <p class="foot-tif" aria-hidden="true">ⵜⴰⵇⴱⴰⵢⵍⵉⵜ</p>
          <p class="foot-name">Kabyle LLM Benchmark</p>
          <p class="foot-about">{d.footAbout}</p>
          <a class="btn btn-ghost-saffron" href={REPO_URL}>{d.repo}</a>
        </div>
        <div>
          <h4>{d.footSite}</h4>
          <ul>
            {pages.map((p) => <li><a class="u-link" href={href(base, p, lang)}>{d.nav[p]}</a></li>)}
            <li><a class="u-link" href={href(base, page, other)} hreflang={other} lang={other}>{d.switchLang}</a></li>
          </ul>
        </div>
        <div>
          <h4>{d.footProject}</h4>
          <ul>
            <li><a class="u-link" href={REPO_URL}>{d.footCode}</a></li>
            <li><a class="u-link" href={dataUrl}>{d.footData}</a></li>
            <li><a class="u-link" href={PROFILE_URL}>{d.footAuthor} · @hasdaouiryma16-cmd</a></li>
          </ul>
        </div>
      </div>
      <div class="wrap foot-bottom">
        <p>© 2026 Kabyle LLM Benchmark <span class="dia">◆</span> {d.license}</p>
        <p>{d.thanks} {d.thanksBody} <span class="dia">◆</span> {d.footMade}</p>
      </div>
      <p class="foot-tanemmirt" aria-hidden="true">ⵜⴰⵏⵎⵉⵔⵜ</p>
    </footer>

    <script is:inline>
      (() => {
        const head = document.querySelector("[data-head]");
        const onScroll = () => head?.classList.toggle("scrolled", window.scrollY > 20);
        onScroll();
        addEventListener("scroll", onScroll, { passive: true });

        const btn = document.querySelector("[data-menu]");
        const menu = document.getElementById("mobile-menu");
        const setOpen = (open) => {
          if (!menu || !btn) return;
          menu.hidden = !open;
          btn.setAttribute("aria-expanded", String(open));
          document.body.classList.toggle("menu-open", open);
        };
        btn?.addEventListener("click", () => setOpen(menu?.hidden ?? false));
        addEventListener("keydown", (e) => e.key === "Escape" && setOpen(false));
        addEventListener("resize", () => innerWidth > 900 && setOpen(false));

        const els = document.querySelectorAll(".reveal");
        if (!("IntersectionObserver" in window)) {
          els.forEach((el) => el.classList.add("is-visible"));
          return;
        }
        const io = new IntersectionObserver(
          (entries) => entries.forEach((e) => e.isIntersecting && (e.target.classList.add("is-visible"), io.unobserve(e.target))),
          { threshold: 0.08, rootMargin: "0px 0px -40px 0px" },
        );
        els.forEach((el) => io.observe(el));
      })();
    </script>
  </body>
</html>
