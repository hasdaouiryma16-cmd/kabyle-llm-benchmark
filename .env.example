# Copier ce fichier en `.env` (jamais commité) puis remplir les valeurs.
# Toutes les clés sont optionnelles : un fournisseur sans clé est simplement désactivé dans le labo.

# --- Fournisseurs de modèles ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
MISTRAL_API_KEY=
OPENROUTER_API_KEY=

# --- Modèles locaux ---
OLLAMA_BASE_URL=http://localhost:11434
# Labo dans Docker : Ollama installé sous Windows est joint par défaut (host.docker.internal).
# Avec Ollama dans Docker (docker compose --profile ollama up -d), décommenter :
# OLLAMA_DOCKER_URL=http://ollama:11434

# --- Labo ---
# Le labo n'écoute que sur la machine locale : ne pas changer sans raison.
LAB_HOST=127.0.0.1
LAB_PORT=8800
# Chemin relatif au dossier backend/ (Docker le remplace par /app/var/lab.db)
DATABASE_URL=sqlite:///./var/lab.db

# --- Garde-fous de coût ---
# Nombre max de requêtes simultanées par fournisseur
MAX_CONCURRENCY_PER_PROVIDER=2
# Plafond de dépense estimé par run (USD), le run s'arrête au-delà
MAX_RUN_COST_USD=5
